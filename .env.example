# Copy to .env and fill in. Never commit .env.
# Two Groq keys (separate accounts), one per stage. Neither is used as a fallback for the other.
GROQ_API_KEY=                # brand voice analysis call
GROQ_API_KEY_BRAND_VOICE=    # tweet generation call
# Optional: override the default Groq model (used by both stages).
# GROQ_MODEL=llama-3.3-70b-versatile

# Optional research. Leave blank to generate from your inputs only.
SCRAPEBADGER_API_KEY=
FIRECRAWL_API_KEY=
